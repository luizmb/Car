<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Connects to the Indimate unit on the bike to play indicator sounds in your helmet.</string>
	<key>NSMotionUsageDescription</key>
	<string>Records barometric pressure and motion during rides, to learn how conditions affect fuel consumption.</string>
	<!-- Declares that the app uses no non-exempt encryption, which is true: the only cryptography
	     involved is standard TLS via URLSession, and that is exempt. Without this key App Store
	     Connect asks the same question on every single TestFlight upload and holds the build until
	     it is answered by hand. The answer never changes, so it belongs here rather than in a
	     workflow making an authenticated API call to say "no" again. -->
	<!-- How Siri should *hear* the app name.
	     "SpeedJarvis" is one unbroken word: Siri parsed it as "speed" plus noise and routed every
	     request to HomeKit — the shortcuts registered fine and every phrase answered "none of your
	     accessories can respond to that". App Shortcut phrases must contain the app name, so the
	     name has to be sayable, and one short common word beats a compound brand nobody says aloud.
	     "Bike speed", "bike speed limit", "bike tyres" are all things a rider would say anyway. -->
	<key>CFBundleSpokenName</key>
	<string>Bike</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>location</string>
		<string>bluetooth-central</string>
	</array>
</dict>
</plist>
